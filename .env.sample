# Optional Cosmos DB Serverless reused from C:\repos\gaia-robot
COSMOS_ENDPOINT=https://gaia-serverless-20260723.documents.azure.com:443/

# Optional default ARC Tracker Developer App Key (users supply their own arc_u1_ key in the UI)
ARCTRACKER_APP_KEY=arc_k1_hobby_companion_dev
PORT=8787
